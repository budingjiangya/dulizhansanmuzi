# 统一行尾为 LF，避免 Windows 工作区与 Linux 部署环境产生整文件级 diff
* text=auto eol=lf

# 显式声明为文本（便于 diff 与合并）
*.ts    text eol=lf
*.tsx   text eol=lf
*.vue   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.prisma text eol=lf
*.sql   text eol=lf
*.env   text eol=lf
*.example text eol=lf

# Windows 批处理脚本必须保留 CRLF，否则无法执行
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制资源：不做行尾转换，diff 时按二进制处理
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.webp  binary
*.ico   binary
*.mp4   binary
*.webm  binary
*.mov   binary
*.woff  binary
*.woff2 binary

# pnpm 锁文件在合并时由 pnpm 重新生成，避免手工解冲突
pnpm-lock.yaml merge=binary linguist-generated=true
