{
  "name": "dulizhan-sanmuzi",
  "version": "1.0.0",
  "private": true,
  "description": "产品推荐博客站点 — 前台内容门户 + RBAC 后台管理系统",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "contracts:typecheck": "pnpm --filter @sanmuzi/contracts typecheck",
    "backend:dev": "pnpm --filter @sanmuzi/backend dev",
    "backend:build": "pnpm --filter @sanmuzi/backend build",
    "backend:prisma:generate": "pnpm --filter @sanmuzi/backend prisma:generate",
    "backend:prisma:migrate": "pnpm --filter @sanmuzi/backend prisma:migrate",
    "backend:seed": "pnpm --filter @sanmuzi/backend seed",
    "portal:dev": "pnpm --filter @sanmuzi/web-portal dev",
    "portal:build": "pnpm --filter @sanmuzi/web-portal build",
    "admin:dev": "pnpm --filter @sanmuzi/web-admin dev",
    "admin:build": "pnpm --filter @sanmuzi/web-admin build",
    "dev": "pnpm --parallel --filter \"./backend-nest\" --filter \"./web-portal\" --filter \"./web-admin\" dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  }
}
