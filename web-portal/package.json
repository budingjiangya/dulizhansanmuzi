    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.14",
    "@types/node": "22.18.1",
    "@vitejs/plugin-vue": "5.2.4",
    "tailwindcss": "4.1.14",
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "vue-tsc": "2.2.10"
  }
}
