{
  "name": "@sanmuzi/web-admin",
  "version": "1.0.0",
  "private": true,
  "description": "后台管理系统：Vue 3.5 + Vite 6 + Naive-UI 2.40 + WangEditor5，JWT 鉴权、RBAC 菜单与按钮权限、博客文章 CRUD、资源分片上传",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:only": "vite build",
    "preview": "vite preview --port 4174",
    "typecheck": "vue-tsc -b --force"
  },
  "dependencies": {
    "@sanmuzi/contracts": "workspace:*",
    "@wangeditor/editor": "5.1.23",
    "@wangeditor/editor-for-vue": "5.1.12",

    "axios": "1.20.0",
    "dayjs": "1.11.18",
    "naive-ui": "2.40.4",
    "pinia": "2.3.1",
    "vue": "3.5.43",
    "vue-router": "4.5.1"
  },
  "devDependencies": {
    "@types/node": "22.18.1",
    "@vitejs/plugin-vue": "5.2.4",
    "typescript": "5.7.3",
    "vite": "6.3.5",
    "vue-tsc": "2.2.10"
  }
}
