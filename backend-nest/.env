# ---------------------------------------------------------------------------
# 后端服务环境变量（真实可用配置，已在 .gitignore 之外显式纳入版本管理）
# ⚠️ 该文件包含明文口令，仅适用于当前内部演示环境；正式上线前必须轮换并改用密钥管理。
# ---------------------------------------------------------------------------

# 服务
NODE_ENV=development
PORT=3000
API_PREFIX=api
# 前台/后台开发服务器地址，用于 CORS 白名单（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# MySQL 8.4（外部连接）
DATABASE_URL="mysql://aaa:A8e5KPpDDiEtfZmB@110.42.32.92:3306/dulizhan"

# Redis（外部连接）：登录失败限流 + 首页列表短缓存 + 分片上传会话
REDIS_URL="redis://:redis_rjsmDK@110.42.32.92:6379/0"
REDIS_KEY_PREFIX=sanmuzi:
# 首页列表缓存秒数，0 表示关闭
PORTAL_CACHE_TTL=30
# 登录失败锁定：窗口秒数 / 最大失败次数 / 锁定时长秒数
LOGIN_FAIL_WINDOW=900
LOGIN_FAIL_MAX=5
LOGIN_LOCK_SECONDS=900

# JWT
JWT_SECRET=sanmuzi-product-blog-dev-secret-please-rotate-in-production
JWT_EXPIRES_IN=2h

# 对象存储驱动：local（本地磁盘 + 静态托管，默认） | minio
STORAGE_DRIVER=local
# 后端对外可访问地址，用于拼接资源绝对地址
PUBLIC_BASE_URL=http://localhost:3000
# MinIO 配置（STORAGE_DRIVER=minio 时生效）
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=sanmuzi

# 视频处理（本机已安装 ffmpeg/ffprobe，留空则从 PATH 查找）
FFMPEG_PATH=
FFPROBE_PATH=
# 上传大小上限（MB）
MAX_IMAGE_SIZE_MB=10
MAX_VIDEO_SIZE_MB=500
MAX_CHUNK_SIZE_MB=8

# 演示素材：种子数据是否下载公开示例视频到本地静态目录（失败则自动回退为远程地址）
SEED_DOWNLOAD_VIDEO=true
