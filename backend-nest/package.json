{
  "name": "@sanmuzi/backend",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS 11 + Prisma 6 后端服务：JWT 鉴权、RBAC 守卫、博客文章 CRUD、FFmpeg 视频抽帧、对象存储上传",
  "scripts": {
    "dev": "nest start --watch",
    "start": "nest start",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "tsx scripts/run-with-env.ts prisma generate",
    "prisma:migrate": "tsx scripts/run-with-env.ts prisma migrate dev",
    "prisma:deploy": "tsx scripts/run-with-env.ts prisma migrate deploy",
    "prisma:push": "tsx scripts/run-with-env.ts prisma db push",
    "prisma:studio": "tsx scripts/run-with-env.ts prisma studio",
    "seed": "tsx scripts/run-with-env.ts tsx prisma/seed.ts",
    "cache:flush": "tsx scripts/flush-cache.ts",
    "bootstrap": "pnpm prisma:generate && pnpm prisma:deploy && pnpm seed"
  },
  "dependencies": {
    "@nestjs/common": "11.1.6",
    "@nestjs/config": "4.0.2",
    "@nestjs/core": "11.1.6",
    "@nestjs/jwt": "11.0.0",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.1.6",
    "@nestjs/serve-static": "5.0.3",
    "@nestjs/swagger": "11.2.0",
    "@prisma/client": "6.19.0",
    "@sanmuzi/contracts": "workspace:*",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "dotenv": "16.6.1",
    "ioredis": "5.8.1",
    "minio": "8.0.7",
    "multer": "2.0.2",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.34.4",
    "svg-captcha": "1.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.10",
    "@nestjs/schematics": "11.0.8",
    "@types/bcryptjs": "2.4.6",
    "@types/express": "5.0.3",
    "@types/multer": "2.0.0",
    "@types/node": "22.18.1",
    "@types/passport-jwt": "4.0.1",
    "prisma": "6.19.0",
    "tsx": "4.20.6",
    "typescript": "5.7.3"
  }
}
